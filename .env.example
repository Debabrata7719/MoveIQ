# =========================================================================
# MoveIQ / Sports Injury Risk Detection — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# =========================================================================

# ── 1. AI & LLM API Keys (Groq & LangSmith) ──────────────────────────────
GROQ_API_KEY="gsk_your_groq_api_key_here"

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="sports-injury-risk-detection"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ── 2. Database Selection ────────────────────────────────────────────────
# Set to "true" to use local localhost databases (MySQL & Local MongoDB).
# Set to "false" to use cloud databases (Supabase PostgreSQL & MongoDB Atlas).
USE_LOCAL_DB="false"

# ── 3. Relational SQL Database (Authentication & User Roles) ─────────────
# Cloud / Supabase PostgreSQL Connection URL (Used when USE_LOCAL_DB=false)
DATABASE_URL="postgresql://username:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# Local MySQL Database Settings (Used when USE_LOCAL_DB=true)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="sports_injury_detection"

# ── 4. NoSQL Database (Profiles, Sessions, Biomechanics & Reports) ───────
# MongoDB Atlas Cloud URI & DB Name (Used when USE_LOCAL_DB=false)
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME="sports_injury_db"

# Local MongoDB URI & DB Name (Used when USE_LOCAL_DB=true)
MONGODB_URI="mongodb://localhost:27017/"
MONGODB_DB="sports_injury_db"

# ── 5. Cloudinary Media Storage (Video & Key Moment Uploads) ─────────────
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── 6. JWT Authentication & Security Tokens ──────────────────────────────
# Provide a secure 32+ character random secret key for signing JWT tokens
JWT_SECRET_KEY="your_super_secret_32_character_jwt_key_here"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Alias names for compatibility across routers
SECRET_KEY="your_super_secret_32_character_jwt_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 7. Google OAuth Credentials (Optional / SSO) ─────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
GOOGLE_TOKEN_URI="https://oauth2.googleapis.com/token"

# ── 8. Redis & Upstash Cache / Rate Limiting (Optional) ──────────────────
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# ── 9. Email Notifications & Alerts (Optional) ───────────────────────────
EMAIL_ADDRESS="your_email@gmail.com"
EMAIL_APP_PASSWORD="your_16_character_app_password_here"

# ── 10. Elasticsearch (Search Engine) ────────────────────────────────────
LOCAL_ELASTICSEARCH_URL="http://localhost:9200"
CLOUD_ELASTICSEARCH_URL="https://your_cloud_elasticsearch_url_here"