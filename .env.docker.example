# ============================================================
# .env.docker.example — Docker-specific Environment Variables
#
# DO NOT ADD REAL SECRETS HERE. 
# Copy this file to .env.docker and fill in your actual API keys.
# ============================================================

# ------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# 2. RELATIONAL DATABASE (PostgreSQL / MySQL)
# ⚠️  IMPORTANT: Use "mysql" (service name), NOT "localhost"
# ------------------------------------------
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sports_injury_detection

# ------------------------------------------
# 3. NOSQL DATABASE (MongoDB)
# ⚠️  IMPORTANT: Use "mongodb" (service name), NOT "localhost"
# ------------------------------------------
MONGO_URI="mongodb://mongodb:27017/"
MONGO_DB_NAME="moveiq"

# ------------------------------------------
# 4. REDIS & CELERY
# ⚠️  IMPORTANT: Use "redis" (service name), NOT "localhost"
# ------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------
# 5. ELASTICSEARCH
# ⚠️  IMPORTANT: Use "elasticsearch" (service name), NOT "localhost"
# ------------------------------------------
USE_LOCAL_DB=true
LOCAL_ELASTICSEARCH_URL=http://elasticsearch:9200
CLOUD_ELASTICSEARCH_URL=https://your-production-es-url.com

# ------------------------------------------
# 6. AUTHENTICATION & JWT
# ------------------------------------------
JWT_SECRET_KEY=your_super_secret_jwt_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------
# 7. THIRD PARTY APIs
# ------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

GROQ_API_KEY="your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------
# 7.5 LANGSMITH (LLM Observability)
# ------------------------------------------
LANGCHAIN_API_KEY="your_langchain_api_key"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="sports-injury-risk-detection"
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------
# 8. EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"

# ------------------------------------------
# 9. OAUTH2 (Google Login)
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google OAuth Endpoints
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v1/certs
